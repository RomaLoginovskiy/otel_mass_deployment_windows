<?xml version="1.0" encoding="utf-8"?>
<!--
  A 2.0-era <system.web>: no targetFramework attribute (it did not exist before 4.0), which is what
  a genuinely old app looks like on disk. The pool, not this file, is what pins CLR 2 -
  managedRuntimeVersion=v2.0 is set when the shape is provisioned - but the config has to be
  2.0-shaped too, or the classifier is reading a 4.x app that merely happens to sit in an old pool.
-->
<configuration>
  <system.web>
    <compilation debug="false" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
