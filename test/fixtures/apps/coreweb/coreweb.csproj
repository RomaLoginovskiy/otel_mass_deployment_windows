<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ONE source, TWO Core majors. The matrix has to prove the .NET auto-instrumentation attaches
    across more than one ASP.NET Core version on the same host, which is the normal state of a
    real fleet host - and a single-TFM fixture cannot show that. Published twice by
    test\fixtures\Build-Fixtures.ps1.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keep the publish output self-describing so the matrix can tell the two apart on disk. -->
    <AssemblyName>coreweb</AssemblyName>
    <RootNamespace>CoreWeb</RootNamespace>
  </PropertyGroup>

</Project>
