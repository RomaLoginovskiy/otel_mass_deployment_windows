<?xml version="1.0" encoding="utf-8"?>
<!--
  What makes this app classify as AspNetFramework: a <system.web> section with a 4.x
  targetFramework and no <aspNetCore>. Resolve-IISAppRuntime.ps1 keys off exactly that, and the
  matrix asserts the classification as well as the telemetry, because a Framework app misread as
  Core gets a pool set to "No Managed Code" and stops running altogether.
-->
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
