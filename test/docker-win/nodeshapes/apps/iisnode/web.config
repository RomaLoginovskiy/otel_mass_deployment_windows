<?xml version="1.0" encoding="utf-8"?>
<!--
  iisnode site. The handler hands server.js to the iisnode native module, so IIS itself runs no
  managed code: the app pool can be No Managed Code and .NET auto-instrumentation has nothing to
  attach to. Resolve-IISAppRuntime.ps1 must classify this as non-.NET / Unsupported on the strength
  of the handler alone.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="nodejs">
          <match url="(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode nodeProcessCommandLine="C:\nodejs\node.exe" loggingEnabled="true" devErrorsEnabled="true" />
  </system.webServer>
</configuration>
