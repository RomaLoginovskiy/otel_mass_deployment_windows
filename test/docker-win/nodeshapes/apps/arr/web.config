<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS as a REVERSE PROXY to a PM2-managed Node app on 127.0.0.1:9101 - SGA's actual architecture
  (11 such sites on OTIOMWQA01, ARR in front of 26 PM2 apps).

  Two things this shape pins, both of which read as bugs if nobody wrote them down:

  1. This site has NO managed code, so .NET auto-instrumentation cannot produce a span for it.
     Resolve-IISAppRuntime.ps1 classifies an ARR rewrite to another port as Unsupported and the
     site stays out of CX_IIS_SERVICES. Correct - not a coverage gap.
  2. ARR is a NATIVE module and does not inject `traceparent`, so the backend Node span has no
     parent and arrives as a trace ROOT. There is no IIS -> Node parent/child link to look for
     unless something upstream already propagates context.

  All app telemetry for this shape therefore comes from the Node side, which is exactly why the
  Node path failing silently was so expensive here.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="proxy-to-pm2-node" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:9101/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
