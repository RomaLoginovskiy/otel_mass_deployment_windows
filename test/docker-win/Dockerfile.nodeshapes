# escape=`
# Windows container for the NODE DEPLOYMENT SHAPE MATRIX (test/docker-win/Run-NodeShapesTest.ps1).
#
# It exists because the service-hosted-PM2 support shipped with only fixture unit tests behind it:
# nothing had ever watched Invoke-CxPm2AsOwner actually reach a PM2 daemon owned by another
# account, and no Node hosting shape other than a per-user PM2 had ever been exercised at all.
# This image can host every shape a Windows fleet host really uses - PM2 per-user, PM2 as a service
# under three different accounts, a stopped daemon with only dump.pm2 on disk, bare node.exe from a
# scheduled task, Node as a service via node-windows, iisnode, and IIS ARR proxying to PM2.
#
# Build from the REPO ROOT so deploy/ is in context:
#   docker build -f test/docker-win/Dockerfile.nodeshapes -t cx-nodeshapes .
# Requires Docker in Windows-container mode (Hyper-V isolation on Win11 clients).
#
# The layer order is deliberate: everything expensive (node, npm-global, otel-node, the collector,
# the MSIs) sits ABOVE the deploy/ + harness scripts, so iterating on the scripts under test
# rebuilds in seconds instead of re-extracting Node.
FROM mcr.microsoft.com/windows/servercore/iis:windowsservercore-ltsc2022

SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
WORKDIR C:\\cx

# Server Core defaults to legacy TLS. Kept for parity with the other images (and for anything that
# reaches out at run time); nothing in this build downloads.
RUN Set-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\.NETFramework\v4.0.30319' -Name SchUseStrongCrypto -Value 1 -Type DWord; `
    Set-ItemProperty -Path 'HKLM:\SOFTWARE\WOW6432Node\Microsoft\.NETFramework\v4.0.30319' -Name SchUseStrongCrypto -Value 1 -Type DWord

# ---- Node.js -------------------------------------------------------------------
# Baked from the official zip, never downloaded: .NET Invoke-WebRequest to nodejs.org fails in this
# Server Core base with "The decryption operation failed" (Schannel), the same limitation that
# forced baking the collector binary. Node 20.11.0 is >= 20, so `--import` exists and the ESM
# shapes are exercisable; Node < 20 (where --import does not exist) is covered by the unit test
# instead, since only one runtime can be baked here.
ARG NODE_VERSION=20.11.0
# OPENSSL_ia32cap disables AES-NI/AVX in node's bundled OpenSSL. Without it npm HTTPS to the
# registry intermittently dies with ERR_SSL_CIPHER_OPERATION_FAILED inside Hyper-V containers.
# Nothing here installs from npm (all node_modules are baked), but the apps and pm2 run under it.
ENV NODE_VERSION=$NODE_VERSION `
    NPM_CONFIG_PREFIX=C:\npm-global `
    OPENSSL_ia32cap=~0x200000200000000
COPY test/docker-win/node.zip C:/node.zip
RUN $ErrorActionPreference='Stop'; `
    $v = $env:NODE_VERSION; `
    & tar.exe -xf C:\node.zip -C C:\; `
    if (-not (Test-Path \"C:\node-v$v-win-x64\")) { throw 'Node.js extract failed' }; `
    Rename-Item -Path \"C:\node-v$v-win-x64\" -NewName C:\nodejs; `
    Remove-Item C:\node.zip -Force; `
    $p = [Environment]::GetEnvironmentVariable('PATH','Machine'); `
    [Environment]::SetEnvironmentVariable('PATH', \"C:\nodejs;C:\npm-global;$p\", 'Machine')

# ---- pm2 + node-windows --------------------------------------------------------
# Installed on the HOST and copied in (in-container npm is unreliable here - see OPENSSL_ia32cap).
#   pm2          : the process manager under test
#   node-windows : how PM2 is really turned into a Windows service (pm2-installer uses it). Ships
#                  lib\wrapper.js and a bundled winsw.exe, which is exactly the process tree the
#                  topology probe has to recognise.
# Prepare with:
#   npm install --prefix test/docker-win/npm-global -g pm2 node-windows
COPY test/docker-win/npm-global/ C:/npm-global/

# ---- OTel Node auto-instrumentation -------------------------------------------
# Baked into the prefix Instrument-NodePM2.ps1 defaults to, so every shape runs with -SkipInstall
# and no shape can fail for a reason as boring as a flaky npm install.
COPY test/docker-win/otel-node/ C:/cx/otel-node/

# ---- the apps ------------------------------------------------------------------
# One shared node_modules (pino) reused from the E2E image's app, placed at the PARENT of the
# variants so cjs/, esm/, mjs/, bare/ and iisnode/ all resolve upward into it. No second host
# install, and no per-variant copy.
COPY test/docker-win/nodeapp/node_modules/ C:/cx/nodeshapes/apps/node_modules/
COPY test/docker-win/nodeshapes/ C:/cx/nodeshapes/

# ---- collector -----------------------------------------------------------------
# Real collector, real Coralogix: the matrix gates each shape locally on the collector's own
# counters (:8888) and then proves arrival once, at the end, with a DataPrime sweep. Key and domain
# come from `docker run -e`, never baked.
COPY test/docker-win/otelcol-contrib.exe C:/cx/otelcol-contrib.exe

# ---- IIS-hosted Node: iisnode + URL Rewrite + ARR ------------------------------
# OPTIONAL. Each MSI is installed only if it was staged into test/docker-win/vendor/ on the host;
# a missing one leaves a marker that setup-nodeshape.ps1 reads and turns into a loud SKIP for that
# shape, rather than a confusing IIS error mid-matrix. Order matters: URL Rewrite BEFORE ARR (ARR's
# installer requires it), iisnode last.
# Staged in vendor/iis/ rather than vendor/ so this COPY does not also drag in the 190 MB of
# Erlang/RabbitMQ installers the other harness keeps there.
# Prepare with (URLs in test/docker-win/README.md):
#   vendor/iis/rewrite_amd64_en-US.msi  vendor/iis/requestRouter_amd64.msi
#   vendor/iis/iisnode-full-*-x64.msi
COPY test/docker-win/vendor/iis/ C:/cx/vendor/
RUN $ErrorActionPreference='Continue'; `
    $installed = @(); `
    function Install-Msi($pattern, $label) { `
      $msi = Get-ChildItem -Path C:\cx\vendor -Filter $pattern -ErrorAction SilentlyContinue | Select-Object -First 1; `
      if (-not $msi) { Write-Host \"[build] SKIP $label - no C:\cx\vendor\$pattern\"; return $null }; `
      Write-Host \"[build] installing $label ($($msi.Name)) ...\"; `
      $p = Start-Process msiexec.exe -ArgumentList '/i', \"`\"$($msi.FullName)`\"\", '/qn', '/norestart' -Wait -PassThru; `
      if ($p.ExitCode -ne 0) { Write-Host \"[build] WARN $label msiexec exit $($p.ExitCode)\"; return $null }; `
      Write-Host \"[build] $label installed\"; return $label `
    }; `
    $installed += Install-Msi 'rewrite_*.msi'        'urlrewrite'; `
    $installed += Install-Msi 'requestRouter_*.msi'  'arr'; `
    $installed += Install-Msi 'iisnode-full-*.msi'   'iisnode'; `
    New-Item -ItemType Directory -Force -Path C:\cx\state | Out-Null; `
    ($installed | Where-Object { $_ }) -join \"`n\" | Set-Content -Path C:\cx\state\iis-modules.txt -Encoding ascii; `
    Write-Host \"[build] IIS modules present: $((($installed | Where-Object { $_ }) -join ', '))\"

# ---- the scripts under test + the harness's in-container half ------------------
# LAST, so editing them does not invalidate anything above.
# scripts/ is deliberately NOT copied: the Verify-Coralogix*.ps1 gates query the backend and run on
# the HOST, from the harness, where the query key lives. Nothing in the container needs them.
COPY deploy/ C:/cx/deploy/
COPY test/docker-win/setup-nodeshape.ps1 C:/cx/setup-nodeshape.ps1
COPY test/docker-win/entrypoint.nodeshapes.ps1 C:/cx/entrypoint.nodeshapes.ps1

ENV CORALOGIX_DOMAIN=eu1.coralogix.com

ENTRYPOINT ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "C:\\cx\\entrypoint.nodeshapes.ps1"]
