# === Local scratch (untracked, not part of the repo) ===
# Contents are scratch, with two exceptions that ARE part of the repo: the standalone
# service-label diagnostics and its runbook section. test/docker-win/Dockerfile does
# `COPY misc/`, so a fresh clone must contain at least the script or the image build fails.
misc/*

misc/*.log

# baked collector binary for the Windows E2E image (do not commit)
test/docker-win/otelcol-contrib.exe

# baked Node.js zip for the Windows E2E image (downloaded on host; do not commit)
test/docker-win/node.zip

# baked node_modules for the Windows E2E image (installed on host, COPY'd into the image;
# in-container npm is unreliable in the Server Core base). Do not commit.
test/docker-win/npm-global/
test/docker-win/otel-node/
test/docker-win/nodeapp/node_modules/

# RabbitMQ test image installers (downloaded on host, baked into image; not committed)
test/docker-win/vendor/
test/
